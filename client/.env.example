# PostgreSQL connection string for the Water Vendor database.
# Use the Supabase pooler URL when deploying from an IPv4-only environment.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Firebase Admin credentials are required to protect API routes in production.
# FIREBASE_ADMIN_PROJECT_ID=""
# FIREBASE_ADMIN_CLIENT_EMAIL=""
# FIREBASE_ADMIN_PRIVATE_KEY=""
